# Copy to .env and fill in. Never commit .env.

# --- Server ---
# Port the HTTP/WebSocket server listens on (defaults to 8080; the Dockerfile sets 3000)
PORT=
# "production" disables the Prisma client dev-reuse cache
NODE_ENV=
# Public base URL shown in the Swagger "servers" list (defaults to http://localhost:$PORT)
PUBLIC_BASE_URL=
# Comma-separated browser origins allowed by CORS (scheme + host + port, no trailing slash),
# e.g. https://app.example.com,https://admin.example.com
# If unset, only localhost / 127.0.0.1 origins (any port) are allowed.
CORS_ORIGINS=

# --- Database (MySQL, used by Prisma) ---
# mysql://USER:PASSWORD@HOST:3306/DB_NAME
DATABASE_URL=

# --- Auth0 ---
# Tenant domain without protocol, e.g. your-tenant.us.auth0.com
AUTH0_DOMAIN=
# Issuer URL WITH trailing slash, e.g. https://your-tenant.us.auth0.com/
AUTH0_ISSUER_BASE_URL=
# API identifier (audience) configured in Auth0
AUTH0_AUDIENCE=

# --- AI service (separate team service for chat, feedback, STT, TTS) ---
# Base URL without trailing slash, e.g. http://localhost:8000
AI_SERVICE_URL=

# --- PortOne (iamport) payment verification ---
# REST API key from the PortOne console
IMP_KEY=
# REST API secret from the PortOne console
IMP_SECRET=
